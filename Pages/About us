<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | Eco Mart</title>
    <style>
        /* Base Styles */
        * {
            margin: 0px;
            padding: 0px;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #d5f3dc;
            color: #191818;
            line-height: 1.6;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0px auto;
            padding: 20px;
        }

        /* Header */
        header {
            background-color: #547a54;
            color: white;
            padding: 20px 0px;
            text-align: center;
        }

        .logo {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .tagline {
            font-size: 18px;
            opacity: 0.9;
        }

        /* Navigation */
        nav {
            background-color: #649164;
            padding: 15px 0px;
        }

        nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
            flex-wrap: wrap;
        }

        nav li {
            margin: 0px 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
            padding: 5px 10px;
            border-radius: 4px;
        }

        nav a:hover {
            color: #a5d6a7;
            background-color: rgba(255, 255, 255, 0.1);
        }

        nav a.active {
            background-color: rgba(255, 255, 255, 0.2);
            color: #a5d6a7;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(45, 90, 60, 0.85), rgba(30, 64, 39, 0.9)), url('https://i.pinimg.com/1200x/e4/98/0a/e4980a532661492832a45fb9ff75af68.jpg');
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 80px 20px;
            margin-bottom: 40px;
            border-radius: 10px;
        }

        .hero h1 {
            font-size: 36px;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .hero p {
            font-size: 18px;
            max-width: 700px;
            margin: 0px auto;
            line-height: 1.8;
        }

        /* Mission Section */
        .mission {
            background-color: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0px 5px 15px rgba(0,0,0,0.05);
            margin-bottom: 50px;
            text-align: center;
        }

        .mission h2 {
            color: #2e7d32;
            margin-bottom: 20px;
            font-size: 28px;
        }

        .mission p {
            font-size: 18px;
            color: #555;
            margin-bottom: 15px;
        }

        /* Team Section */
        .team-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .team-header h2 {
            color: #2e7d32;
            font-size: 32px;
            margin-bottom: 15px;
        }

        .team-header p {
            color: #666;
            font-size: 18px;
            max-width: 600px;
            margin: 0px auto;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .team-card {
            background-color: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.08);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .team-card:hover {
            transform: translateY(-10px);
            box-shadow: 0px 15px 30px rgba(0,0,0,0.12);
        }

        .member-header {
            background-color: #4a7c59;
            color: white;
            padding: 25px;
            text-align: center;
           
        }

        .member-photo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 5px solid white;
            margin: 0px auto 15px;
           
            background-color: #e0f2e0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .member-photo i {
            font-size: 70px;
            color: #4a7c59;
        }

        .member-name {
            font-size: 22px;
            margin-bottom: 5px;
        }

        .member-role {
            font-style: italic;
            opacity: 0.9;
            font-size: 16px;
        }

        .portfolio-link {
            display: inline-block;
            background-color: white;
            color: #4a7c59;
            padding: 8px 16px;
            border-radius: 20px;
            text-decoration: none;
            font-weight: 600;
            margin-top: 15px;
            transition: all 0.3s;
        }

        .portfolio-link:hover {
            background-color: #e0f2e0;
            transform: scale(1.05);
        }

        .member-content {
            padding: 25px;
        }

        .skills-section, .education-section, .experience-section {
            margin-bottom: 25px;
        }

        .section-title {
            color: #2e7d32;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .section-title i {
            margin-right: 10px;
        }

        .skills-list {
            display: flex;
           
            gap: 8px;
        }

        .skill-tag {
            background-color: #e8f5e9;
            color: #2e7d32;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
        }

        .education-item, .experience-item {
            margin-bottom: 10px;
            padding-left: 20px;
          
        }

        .education-item:before, .experience-item:before {
            content: "•";
            color: #4a7c59;
           
            left: 0px;
        }

        .item-title {
            font-weight: 600;
            color: #333;
            font-size: 16px;
        }

        .item-details {
            color: #666;
            font-size: 14px;
        }

        /* Footer */
        footer {
            background-color: #1e4027;
            color: white;
            padding: 40px 0px;
            text-align: center;
        }

        .footer-content {
            display: flex;
          
            justify-content: space-around;
            max-width: 1200px;
            margin: 0px auto 30px;
        }

        .footer-section {
            flex: 1;
            min-width: 250px;
            margin: 20px;
            text-align: left;
        }

        .footer-section h3 {
            margin-bottom: 20px;
            color: #a5d6a7;
            font-size: 20px;
        }

        .footer-section p, .footer-section a {
            color: #ddd;
            text-decoration: none;
            margin-bottom: 10px;
            display: block;
        }

        .footer-section a:hover {
            color: #c8e6c9;
            text-decoration: underline;
        }

        .footer-section i {
            margin-right: 10px;
            width: 20px;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 20px;
            font-size: 14px;
            color: #aaa;
        }

        /* Portfolio Modal */
        .portfolio-modal {
            display: none;
            position: fixed;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .portfolio-content {
            background-color: white;
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            border-radius: 10px;
            padding: 30px;
          
        }

     

        .portfolio-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .portfolio-header h2 {
            color: #2e7d32;
            margin-bottom: 10px;
        }

        .portfolio-header p {
            color: #666;
        }

        .portfolio-section {
            margin-bottom: 25px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .team-grid {
                grid-template-columns: 1fr;
            }
            
            nav ul {
                flex-direction: column;
                align-items: center;
            }
            
            nav li {
                margin: 5px 0px;
            }
            
            .hero h1 {
                font-size: 28px;
            }
            
            .hero p {
                font-size: 16px;
            }
            
            .footer-content {
                flex-direction: column;
                align-items: center;
            }
            
            .footer-section {
                text-align: center;
            }
        }
    </style>
