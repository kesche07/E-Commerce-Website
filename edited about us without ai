        }

        .team-header p {
            color: #666;
            font-size: 18px;
            max-width: 600px;
            margin: 0px auto;
        }
          .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }
         .team-card {
            background-color: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.08);
            transition: transform 0.3s, box-shadow 0.3s;
        }
          .member-header {
            background-color: #4a7c59;
            color: white;
            padding: 25px;
            text-align: center;
           
        }
         .member-photo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 5px solid white;
            margin: 0px auto 15px;
           
            background-color: #e0f2e0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
            .member-photo i {
            font-size: 70px;
            color: #4a7c59;
        }
        .member-name {
            font-size: 22px;
            margin-bottom: 5px;
        }
         .member-role {
            font-style: italic;
            opacity: 0.9;
            font-size: 16px;
        }
           /* Portfolio Modal */
        .portfolio-modal {
            display: none;
            position: fixed;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        
          
        
        @media (max-width: 768px) {
            
            
